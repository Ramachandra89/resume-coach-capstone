# ═══════════════════════════════════════════════════════
# Resume Coach AI - Environment Variables Template
# Copy to .env and fill in real values. Never commit .env.
# ═══════════════════════════════════════════════════════

# ── Inference Backend ──
# Options: nebius | local_hf | sagemaker
INFERENCE_BACKEND=sagemaker

# ── Nebius API (for dev/testing/evaluation) ──
NEBIUS_API_KEY=your-nebius-api-key
NEBIUS_MODEL=meta-llama/Llama-3.3-70B-Instruct

# ── AWS ──
# Leave blank on EC2 if an IAM instance role is attached — boto3 picks it up automatically
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

ECR_REPOSITORY=YOUR_ACCOUNT_ID.dkr.ecr.us-east-1.amazonaws.com/resume-llm-analyzer
EC2_HOST=YOUR_EC2_PUBLIC_IP
S3_BUCKET_NAME=your-s3-bucket-name

# ── SageMaker JumpStart (active inference backend) ──
SAGEMAKER_ENDPOINT_NAME=jumpstart-dft-llama-3-2-3b-instruct-YYYYMMDD-HHMMSS
# SAGEMAKER_EXECUTION_ROLE only needed when deploying a NEW endpoint from a local machine.
# When running inside SageMaker Studio, the role is auto-detected — leave this unset.
# SAGEMAKER_EXECUTION_ROLE=arn:aws:iam::YOUR_ACCOUNT_ID:role/AmazonSageMaker-ExecutionRole

# ── Local HuggingFace Inference (EC2 production, not active) ──
HF_LOCAL_MODEL_DIR=/opt/ml/models/llama-3.1-8b
HF_MODEL_ID=meta-llama/Llama-3.1-8B-Instruct
HF_MODEL_S3_PATH=s3://your-bucket/models/llama-3.1-8b-instruct/
HF_USE_4BIT=true
HF_TOKEN=your-huggingface-token

# ── Application ──
APP_HOST=0.0.0.0
APP_PORT=8000
STREAMLIT_PORT=8501
API_BASE_URL=http://localhost:8000

# ── LangChain Memory ──
MEMORY_MAX_TOKEN_LIMIT=3000

# ── Logging ──
LOG_LEVEL=INFO
